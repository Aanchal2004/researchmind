RESEARCHMIND_APP_NAME=ResearchMind API
RESEARCHMIND_APP_ENV=local
RESEARCHMIND_APP_VERSION=0.1.0
RESEARCHMIND_DEBUG=true
RESEARCHMIND_API_PREFIX=/api
RESEARCHMIND_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
RESEARCHMIND_LOG_LEVEL=INFO
RESEARCHMIND_SEARCH_DEFAULT_LIMIT=10
RESEARCHMIND_SEARCH_MAX_LIMIT=25
RESEARCHMIND_SEARCH_USE_STUB_PROVIDER=false
RESEARCHMIND_ARXIV_ENABLED=true
RESEARCHMIND_ARXIV_BASE_URL=https://export.arxiv.org/api/query
RESEARCHMIND_ARXIV_MAX_RESULTS_PER_REQUEST=12
RESEARCHMIND_ARXIV_PAGE_SIZE=4
RESEARCHMIND_ARXIV_RETRY_ATTEMPTS=2
RESEARCHMIND_ARXIV_RETRY_BACKOFF_SECONDS=1.0
RESEARCHMIND_ARXIV_RETRY_JITTER_SECONDS=0.5
RESEARCHMIND_ARXIV_REQUEST_TIMEOUT_SECONDS=10.0
RESEARCHMIND_ARXIV_TOTAL_BUDGET_SECONDS=10.0
RESEARCHMIND_ARXIV_MIN_INTERVAL_SECONDS=3.1
RESEARCHMIND_ARXIV_CACHE_TTL_SECONDS=120.0
RESEARCHMIND_ARXIV_CIRCUIT_BREAKER_THRESHOLD=3
RESEARCHMIND_ARXIV_CIRCUIT_BREAKER_OPEN_SECONDS=30.0
RESEARCHMIND_ARXIV_MAX_CONCURRENT_REQUESTS=1
RESEARCHMIND_ARXIV_SORT_BY=relevance
RESEARCHMIND_ARXIV_SORT_ORDER=descending
RESEARCHMIND_SEMANTIC_SCHOLAR_ENABLED=true
RESEARCHMIND_SEMANTIC_SCHOLAR_API_KEY=
RESEARCHMIND_SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1/paper/search
RESEARCHMIND_SEMANTIC_SCHOLAR_MAX_RESULTS_PER_REQUEST=10
RESEARCHMIND_SEMANTIC_SCHOLAR_RETRY_ATTEMPTS=2
RESEARCHMIND_SEMANTIC_SCHOLAR_RETRY_BACKOFF_SECONDS=1.5
RESEARCHMIND_SEMANTIC_SCHOLAR_RETRY_JITTER_SECONDS=0.5
RESEARCHMIND_SEMANTIC_SCHOLAR_REQUEST_TIMEOUT_SECONDS=12.0
RESEARCHMIND_SEMANTIC_SCHOLAR_TOTAL_BUDGET_SECONDS=12.0
RESEARCHMIND_SEMANTIC_SCHOLAR_MIN_INTERVAL_SECONDS=1.1
RESEARCHMIND_SYNTHESIS_ENABLED=true
RESEARCHMIND_SYNTHESIS_MAX_PAPERS=5
RESEARCHMIND_SYNTHESIS_MAX_ABSTRACT_CHARS=1200
RESEARCHMIND_HTTP_TIMEOUT_SECONDS=10.0
# LLM synthesis — set to "gemini" and provide an API key to enable
RESEARCHMIND_LLM_PROVIDER=disabled
RESEARCHMIND_LLM_GEMINI_API_KEY=
RESEARCHMIND_LLM_GEMINI_MODEL=gemini-2.0-flash
RESEARCHMIND_LLM_TEMPERATURE=0.2
RESEARCHMIND_LLM_MAX_OUTPUT_TOKENS=1024
RESEARCHMIND_LLM_REQUEST_TIMEOUT_SECONDS=30.0
RESEARCHMIND_LLM_SYNTHESIS_CACHE_TTL_SECONDS=300.0
# PubMed (NCBI E-utilities) — set to true to enable
RESEARCHMIND_PUBMED_ENABLED=true
RESEARCHMIND_PUBMED_API_KEY=
RESEARCHMIND_PUBMED_MAX_RESULTS_PER_REQUEST=10
RESEARCHMIND_PUBMED_RETRY_ATTEMPTS=2
RESEARCHMIND_PUBMED_RETRY_BACKOFF_SECONDS=1.0
RESEARCHMIND_PUBMED_RETRY_JITTER_SECONDS=0.5
RESEARCHMIND_PUBMED_REQUEST_TIMEOUT_SECONDS=12.0
RESEARCHMIND_PUBMED_TOTAL_BUDGET_SECONDS=14.0
RESEARCHMIND_PUBMED_MIN_INTERVAL_SECONDS=0.34
# Crossref — provide your email for polite pool access
RESEARCHMIND_CROSSREF_ENABLED=true
RESEARCHMIND_CROSSREF_MAILTO=
RESEARCHMIND_CROSSREF_MAX_RESULTS_PER_REQUEST=10
RESEARCHMIND_CROSSREF_RETRY_ATTEMPTS=2
RESEARCHMIND_CROSSREF_RETRY_BACKOFF_SECONDS=1.0
RESEARCHMIND_CROSSREF_RETRY_JITTER_SECONDS=0.5
RESEARCHMIND_CROSSREF_REQUEST_TIMEOUT_SECONDS=12.0
RESEARCHMIND_CROSSREF_TOTAL_BUDGET_SECONDS=14.0
RESEARCHMIND_CROSSREF_MIN_INTERVAL_SECONDS=0.5
# Unpaywall — provide your email, set to true to enrich results with OA PDF URLs
RESEARCHMIND_UNPAYWALL_ENABLED=false
RESEARCHMIND_UNPAYWALL_EMAIL=your@email.com
RESEARCHMIND_UNPAYWALL_REQUEST_TIMEOUT_SECONDS=5.0
RESEARCHMIND_UNPAYWALL_MIN_INTERVAL_SECONDS=0.2
RESEARCHMIND_UNPAYWALL_MAX_CONCURRENT=4
